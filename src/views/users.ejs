<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>
                        Name
                    </th>
                    <th>
                        Email / Username
                    </th>
                    <th>
                        Role
                    </th>
                </tr>
            </thead>
            <tbody>
                <% usersList.forEach(userItem => { %>
                    <tr>
                        <td>
                            <%= userItem.name %>
                        </td>
                        <td>
                            <%= userItem.email %>
                        </td>
                        <td class="role-<%= userItem.role_name %>">
                            <%= userItem.role_name %>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</main>
<%- include('partials/footer') %>