<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    
    <h2><%= project.title %></h2>
    <p><strong>Date:</strong> <%= project.date %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Description:</strong> <%= project.description %></p>
    
    <p>
        <strong>Partner Organization:</strong> 
        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>
    <h3>Category Tags</h3>
    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>"><%= category.category_name %></a>
            </li>
        <% }) %>
    </ul>
    <p>
        <% if (user && user.role_name === 'admin') { %>
        <a href="/assign-categories/<%= project.project_id %>" class="button">
            Edit Categories
        </a>
        <% } %>
    </p>
    <p>
        <% if (user && user.role_name === 'admin') { %>
        <a href="/edit-project/<%= project.project_id %>" class="button">
            Edit Project
        </a>
        <% } %>
    </p>
    <% if (isLoggedIn) { %>
        <div class="volunteer-section" style="margin-top: 20px; padding: 15px; border: 1px solid #ccc;">
            <% if (isVolunteer) { %>
                <p>
                    <strong>
                        You are volunteering for this project!
                    </strong>
                </p>
                <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                    <button type="submit" class="button button-danger">
                        Remove me as a volunteer
                    </button>
                </form>
            <% } else { %>
                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit" class="button button-success">
                        Volunteer for this Project
                    </button>
                </form>
            <% } %>
        </div>
    <% } %>
</main>
<%- include('partials/footer') %>