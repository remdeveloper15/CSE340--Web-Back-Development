<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    
    <form action="/edit-project/<%= project.project_id %>" method="POST">
        <div class="form-group">
            <label for="title">Project Title</label>
            <input type="text" id="title" name="title" value="<%= project.title %>" required />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <!-- El textarea no lleva atributo value, el contenido va en medio -->
            <textarea id="description" name="description" required><%= project.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" value="<%= project.location %>" required />
        </div>

        <div class="form-group">
            <label for="projectDate">Date</label>
            <!-- Usamos la fecha formateada -->
            <input type="date" id="projectDate" name="projectDate" value="<%= formattedDate %>" required />
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <option value="">Select an Organization</option>
                <% organizations.forEach(org => { %>
                    <option 
                        value="<%= org.organization_id %>" 
                        <%= project.organization_id === org.organization_id ? 'selected' : '' %>>
                        <%= org.name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <button type="submit">Update Project</button>
    </form>
</main>
<%- include('partials/footer') %>