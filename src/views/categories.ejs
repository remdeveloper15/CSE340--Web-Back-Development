<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <a href="/new-category">
        Add New Category
    </a>
    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>"><%= category.category_name %></a>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>